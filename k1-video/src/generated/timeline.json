   ],
   "cues": [
    {
     "lines": [
      "皮膚では、まず物質が皮膚の表面に触れます"
     ],
     "start": 0.6,
     "end": 4.204,
     "lineId": "c03-s90-l1"
    },
    {
     "lines": [
      "物質や皮膚の状態などによっては",
      "その一部が皮膚の中や血液へ移行する場合があります"
     ],
     "start": 4.754,
     "end": 11.747,
     "lineId": "c03-s90-l2"
    },
    {
     "lines": [
      "そのため、触れる部位、製品の量、接触時間などを考えます"
     ],
     "start": 12.297,
     "end": 18.343,
     "lineId": "c03-s90-l3"
    },
    {
     "lines": [
      "表面に付いたことと、身体の中に吸収されたことは",
      "同じではありません"
     ],
     "start": 18.893,
     "end": 25.01,
     "lineId": "c03-s90-l4"
    }
