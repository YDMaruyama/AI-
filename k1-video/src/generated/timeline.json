   ],
   "cues": [
    {
     "lines": [
      "フッ素樹脂加工のフライパンでは",
      "二つの注意を分けて考えます"
     ],
     "start": 0.6,
     "end": 5.691,
     "lineId": "c09-s90-l1"
    },
    {
     "lines": [
      "硬い金属製のヘラや研磨剤などで表面を傷つけると",
      "コーティングの一部が剥がれ、食品に混じることがあります"
     ],
     "start": 6.241,
     "end": 15.15,
     "lineId": "c09-s90-l2"
    },
    {
     "lines": [
      "表面に使われるPTFEも合成樹脂の一種で、剥がれた微細な",
      "破片を、食べ物と一緒に飲み込む可能性があります"
     ],
     "start": 15.7,
     "end": 24.609,
     "lineId": "c09-s90-l3"
    },
    {
     "lines": [
      "ただし、剥がれた粒子を飲み込むことと",
      "健康被害が起こることは同じではありません"
     ],
     "start": 25.159,
     "end": 31.886,
     "lineId": "c09-s90-l4"
    },
    {
     "lines": [
      "ドイツの公的なリスク評価機関は",
      "傷から生じた微小なPTFE粒子を飲み込んでも"
     ],
     "start": 32.436,
     "end": 39.163,
     "lineId": "c09-s90-l5"
    },
    {
     "lines": [
      "消化されずに排出され",
      "健康への悪影響は予想されないとしています"
     ],
     "start": 39.163,
     "end": 44.618,
     "lineId": "c09-s90-l5"
    },
    {
     "lines": [
      "使うときは、メーカーが認める調理道具を使い",
      "表面を強く削らないようにします"
     ],
     "start": 45.168,
     "end": 51.532,
     "lineId": "c09-s90-l6"
    },
    {
     "lines": [
      "剥がれが広がった場合は",
      "メーカーの交換案内を確認しましょう"
     ],
     "start": 52.082,
     "end": 57.173,
     "lineId": "c09-s90-l7"
    },
    {
     "lines": [
      "一方、空焚きによる過熱には、別の注意が必要です"
     ],
     "start": 57.723,
     "end": 61.541,
     "lineId": "c09-s90-l8"
    },
    {
     "lines": [
      "PTFEは著しく過熱されると分解し",
      "有害なガスを生じることがあります"
     ],
     "start": 62.091,
     "end": 68.091,
     "lineId": "c09-s90-l9"
    },
    {
     "lines": [
      "これは粒子を食べる問題とは異なります",
      "空のまま強火で熱し続けないようにしましょう"
     ],
     "start": 68.641,
     "end": 75.732,
     "lineId": "c09-s90-l10"
    },
    {
     "lines": [
      "傷による破片と、過熱によるガス",
      "二つは別の注意として覚えておきましょう"
     ],
     "start": 76.282,
     "end": 82.282,
     "lineId": "c09-s90-l11"
    }
   ],
