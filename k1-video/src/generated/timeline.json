   "cues": [
    {
     "lines": [
      "三つ目は、ホルモンを作る過程を変える場合です"
     ],
     "start": 0.6,
     "end": 4.418,
     "lineId": "c06-s95-l1"
    },
    {
     "lines": [
      "ホルモンの合成に関わる酵素や細胞に作用し",
