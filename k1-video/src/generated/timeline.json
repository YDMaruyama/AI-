   "cues": [
    {
     "lines": [
      "三つ目は、ホルモンを作る過程を変える場合です"
     ],
     "start": 0.6,
     "end": 4.294,
     "lineId": "c06-s95-l1"
    },
    {
     "lines": [
      "ホルモンの合成に関わる酵素や細胞に作用し",
      "作られる量を変える場合があります"
     ],
     "start": 4.844,
     "end": 11.391,
     "lineId": "c06-s95-l2"
    },
    {
     "lines": [
      "一部のフタル酸エステルで研究されている",
      "胎仔のテストステロン産生の低下が一例です"
     ],
     "start": 11.941,
     "end": 18.71,
     "lineId": "c06-s95-l3"
    },
    {
     "lines": [
