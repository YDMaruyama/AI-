   "cues": [
    {
     "lines": [
      "一つ目は、受容体を動かす場合です"
     ],
     "start": 0.6,
     "end": 3.327,
     "lineId": "c06-s93-l1"
    },
    {
     "lines": [
      "本来のホルモンに似た作用を示し、必要なタイミングや",
      "強さとは異なる信号を送る場合があります"
     ],
     "start": 3.877,
     "end": 11.695,
     "lineId": "c06-s93-l2"
    },
    {
     "lines": [
      "BPAのエストロゲン受容体への作用は",
      "その代表的な研究対象です"
     ],
     "start": 12.245,
     "end": 17.7,
     "lineId": "c06-s93-l3"
    }
   ],
